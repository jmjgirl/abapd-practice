managed implementation in class zbp_r_abapd_travel unique;
strict ( 2 );
with draft;

define behavior for ZR_ABAPD_TRAVEL alias Travel
persistent table zabapd_travel
draft table zabapd_travel_d
lock master total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  action ( features : instance ) acceptTravel result [1] $self;

// draft 관련
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare { validation validatePrice; }

  field ( mandatory : create, readonly : update ) TravelId;
  field ( mandatory ) Description;
  field ( readonly ) Status, StatusText, LocalCreatedBy, LocalCreatedAt, LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

//  저장 직전 검사
  validation validatePrice on save { create; update; field TotalPrice; }
//  값이 바뀔 때 자동 계산
  determination setStatus on modify { create; }

  mapping for zabapd_travel
  {
    TravelId           = travel_id;
    AgencyId           = agency_id;
    Description        = description;
    TotalPrice         = total_price;
    CurrencyCode       = currency_code;
    Status             = status;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}